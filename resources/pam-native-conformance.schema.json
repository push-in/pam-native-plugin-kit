{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pam.dev/schemas/pam-native-conformance.v1.schema.json",
    "title": "PAM Native plugin conformance report",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "surfaceCode", "resultCode", "checks"],
    "properties": {
        "schemaVersion": {"const": 1},
        "surfaceCode": {"const": 2},
        "resultCode": {"type": "integer", "enum": [1, 2], "description": "1 passed, 2 failed"},
        "checks": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["checkCode", "resultCode", "message", "evidenceSha256"],
                "properties": {
                    "checkCode": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6, 7]},
                    "resultCode": {"type": "integer", "enum": [1, 2]},
                    "message": {"type": "string", "minLength": 1, "maxLength": 256},
                    "evidenceSha256": {
                        "oneOf": [
                            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                            {"type": "null"}
                        ]
                    }
                }
            }
        }
    }
}
